 // Integer square root (for sugar map non-linear compression)
 static uint8_t iSqrt(uint16_t n)
 {
     if (n == 0) return 0;
     uint16_t x = n;
     uint16_t y = (x + 1) >> 1;
     while (y < x) { x = y; y = (x + n / x) >> 1; }
     return (uint8_t)x;
 }
